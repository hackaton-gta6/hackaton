{
  "name": "control-de-caja",
  "private": true,
  "version": "0.2.0",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev -w @control-de-caja/mobile",
    "server": "npm run dev -w @caja/server",
    "build": "npm run build -ws --if-present",
    "build:android": "npm run build -w @control-de-caja/mobile && npx cap sync android",
    "lint": "eslint .",
    "test": "npm run test -ws --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0"
  },
  "engines": { "node": ">=20" }
}